{
  "name": "spool-ai",
  "version": "0.25.0",
  "description": "A small CLI and agent skills that turn what you say into tasks, have coding agents work them on their own, and come back only for the calls that are yours.",
  "keywords": [
    "ai-agents",
    "coding-agents",
    "claude-code",
    "agent-skills",
    "task-queue",
    "human-in-the-loop",
    "spec-driven",
    "cli"
  ],
  "license": "MIT",
  "author": "Daniel Portnov",
  "homepage": "https://github.com/danielportnov/spool#readme",
  "bugs": {
    "url": "https://github.com/danielportnov/spool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielportnov/spool.git"
  },
  "type": "module",
  "bin": {
    "spool": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "rules",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "node --test --test-timeout=300000 test/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run check && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.0"
  }
}
